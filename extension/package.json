{
  "name": "extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bnr": "sh misc/devon; vite build; sh misc/devoff",
    "b": "npm run bnr && sleep 0.5 && open \"http://reload.extensions\"",
    "preview": "vite preview",
    "watch": "npm-watch",
    "bd": "VITE_DEBUG=true vite build",
    "bz": "VITE_DEBUG=false vite build && rm -r dist/.vite && rm -f ext.zip && zip -r ext.zip dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "watch": {
    "bnr": {
      "patterns": [
        "src"
      ],
      "extensions": [
        "ts",
        "svelte",
        "js"
      ]
    }
  },
  "devDependencies": {
    "@iconify-json/jam": "^1.1.8",
    "@iconify-json/tabler": "^1.1.109",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@tsconfig/svelte": "^5.0.2",
    "autoprefixer": "^10.4.18",
    "daisyui": "^4.7.3",
    "postcss": "^8.4.35",
    "svelte": "^4.2.11",
    "svelte-check": "^3.6.4",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "unplugin-icons": "^0.18.5",
    "vite": "^5.1.4"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@extend-chrome/messages": "^1.2.2",
    "@trpc/client": "^10.45.1",
    "@trpc/server": "^10.45.1",
    "@types/chrome": "^0.0.262",
    "@types/rangy": "^0.0.38",
    "@yaireo/tagify": "^4.27.0",
    "devalue": "^4.3.2",
    "fflate": "^0.8.2",
    "fp-ts": "^2.16.2",
    "fp-ts-std": "^0.18.0",
    "fuzzysort": "^2.0.4",
    "idb-keyval": "^6.2.1",
    "immer": "^10.0.4",
    "npm-watch": "^0.11.0",
    "rangy": "^1.3.1",
    "rxjs": "^7.8.1",
    "structurajs": "^0.12.0",
    "svelte-persisted-store": "^0.9.1",
    "theme-change": "^2.5.0",
    "trpc-chrome": "^1.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  }
}

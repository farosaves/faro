{
  "name": "myroot",
  "dependencies": {
    "@yaireo/tagify": "^4.27.0",
    "devalue": "^4.3.2",
    "fflate": "^0.8.2",
    "fp-ts-std": "^0.19.1",
    "idb-keyval": "^6.2.1",
    "nodemon": "^3.1.0",
    "npm-watch": "^0.11.0",
    "playwright": "^1.42.1",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.2",
    "svelte-persisted-store": "^0.9.1",
    "ts-pattern": "^5.1.0",
    "uuid": "^9.0.1"
  },
  "scripts": {
    "watchf": "npm-watch",
    "check": "svelte-check --workspace=extension/",
    "format": "# find */src/**/*.ts -mtime -5s -exec npx eslint --fix {} \\; #npx prettier --write '*/src/**/*.{ts,svelte}' --config=.prettierrc.yaml",
    "b": "npm run bnr -w=extension/",
    "e2e": "npx playwright test",
    "unit": "npx vitest run",
    "test": "npm run unit && npm run e2e",
    "icons": "svgexport icon.svg extension/public/icons/icon16.png 16:16; svgexport icon.svg extension/public/icons/icon48.png 48:48; svgexport icon.svg extension/public/icons/icon128.png 128:128",
    "testdocker": "docker run --env-file=.testenv -e COMMIT_UUID=$COMMIT_UUID --ipc=host --init -ti -v ./tests:/usr/src/tests mcr.microsoft.com/playwright:v1.42.1 /bin/bash -c 'cd /usr/src && npm install -D @playwright/test && npx playwright test'",
    "build": "npm run build -w=extension/"
  },
  "watch": {
    "b": {
      "patterns": [
        "extension/src/"
      ],
      "extensions": [
        "ts",
        "js",
        "svelte"
      ]
    }
  },
  "devDependencies": {
    "@iconify-json/jam": "^1.1.8",
    "@iconify-json/logos": "^1.1.42",
    "@playwright/test": "^1.42.1",
    "@stylistic/eslint-plugin": "^1.7.0",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/yaireo__tagify": "^4.24.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "immer": "^10.0.4",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.39",
    "sass": "^1.77.6",
    "svgexport": "^0.4.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.2",
    "typescript-eslint": "^7.3.1",
    "vitest": "^1.4.0",
    "web-ext": "^7.11.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.6.1"
  },
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "workspaces": [
    "extension",
    "site"
  ]
}
